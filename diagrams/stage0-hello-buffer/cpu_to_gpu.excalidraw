      "updated": 1790161865565,
      "link": null,
      "locked": false,
      "text": "1. Upload: Copy [1,2,3,4,5,6] into GPU buffer \"in\"\n2. Dispatch(6): \"Run this function 6 times\"\n3. Readback: Copy GPU buffer \"out\" back to the CPU\n(after GPU is done)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Upload: Copy [1,2,3,4,5,6] into GPU buffer \"in\"\n2. Dispatch(6): \"Run this function 6 times\"\n3. Readback: Copy GPU buffer \"out\" back to the CPU\n(after GPU is done)",
      "autoResize": true,
      "lineHeight": 1.25
    },
