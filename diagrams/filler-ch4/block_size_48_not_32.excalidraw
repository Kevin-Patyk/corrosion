    {
      "id": "8hLsyPjCzW8ucqVh4hPXm",
      "type": "text",
      "x": 1541.1143276738599,
      "y": 868.7498645971584,
      "width": 71.29998779296875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
