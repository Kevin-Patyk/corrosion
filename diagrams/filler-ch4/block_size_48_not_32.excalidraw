    {
      "id": "6LcmLJFX9_jHxG93LkU20",
      "type": "text",
      "x": 378.6540826210937,
      "y": 1357.4717521821542,
      "width": 652.2999267578125,
      "height": 47.792843453537266,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5Q",
      "roundness": null,
      "seed": 354934121,
      "version": 1371,
      "versionNonce": 1788025479,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409711491,
      "link": null,
      "locked": false,
      "text": "28 extras of 128 threads (22%), all in the last block. They are real threads: they run the check, fail it,\nand sit idle for the rest of the kernel. This is usually unavoidable: the data size is what it is.\nCost is small when n is large.",
      "fontSize": 12.744758254276604,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "28 extras of 128 threads (22%), all in the last block. They are real threads: they run the check, fail it,\nand sit idle for the rest of the kernel. This is usually unavoidable: the data size is what it is.\nCost is small when n is large.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0GZ0KAZ2XQc2g2iTyENMy",
