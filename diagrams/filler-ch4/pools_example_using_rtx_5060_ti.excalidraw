    },
    {
      "id": "bEVGByC4I6b8aqHkiz1sV",
      "type": "text",
      "x": -19.67982482617208,
      "y": 874.1249995123294,
      "width": 919.4872436523438,
      "height": 38.41251148767064,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 1879808129,
      "version": 1220,
      "versionNonce": 983329491,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793887290012,
      "link": null,
      "locked": false,
      "text": "5. Registers run out at 4. Two thread-seat slots (512 seats) and 20 block seats are left over and nobody can use them.\n4 blocks x 36 SMs = 144 blocks per wave; 2,955 / 144 = 20.5 = 21 waves. More waves for the same work.",
      "fontSize": 15.365004595068255,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Registers run out at 4. Two thread-seat slots (512 seats) and 20 block seats are left over and nobody can use them.\n4 blocks x 36 SMs = 144 blocks per wave; 2,955 / 144 = 20.5 = 21 waves. More waves for the same work.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q3qWXIHFLcm4tASshBw40",
