      "width": 956.0000000000002,
      "height": 586.4444444444443,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 39138721,
      "version": 497,
      "versionNonce": 1238734448,
      "isDeleted": false,
