      "seed": 1366130669,
      "version": 551,
      "versionNonce": 1208145956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791980844734,
      "link": null,
      "locked": false,
      "text": "Notes:\n\n- Memory has no rows. A picture is stored one row after another: \"row-major\".\n- Pixel (row, col) is at: row * width + col\ne.g. row 1, col 2 = 1 * 4 + 2 = 6\n- width = the jump to go down one row (the \"stride\").\nMoving right = +1, moving down = +width.\n- A color pixel is 3 values (r,g,b) side by side, so its first\nvalue is at (row * width + col) * 3.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notes:\n\n- Memory has no rows. A picture is stored one row after another: \"row-major\".\n- Pixel (row, col) is at: row * width + col\ne.g. row 1, col 2 = 1 * 4 + 2 = 6\n- width = the jump to go down one row (the \"stride\").\nMoving right = +1, moving down = +width.\n- A color pixel is 3 values (r,g,b) side by side, so its first\nvalue is at (row * width + col) * 3.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
