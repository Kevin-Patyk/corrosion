    {
      "id": "oieCmxH0ExPKOkMamFFd2",
      "type": "text",
      "x": -471.5400021223028,
      "y": 126.3571432380952,
      "width": 761.5995483398438,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
