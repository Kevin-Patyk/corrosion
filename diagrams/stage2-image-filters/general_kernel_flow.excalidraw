      "updated": 1792419869614,
      "link": null,
      "locked": false,
      "text": "rgb: the color picture, 3 bytes per pixel (read-only)\n\ngray: output buffer + its width, via RowWidth ->\nused for the col check (2a) and the output spot (5)\n\nwidth: plain number -> used to linearize the input (3)\nheight: plain number -> used for the row check (2b) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "rgb: the color picture, 3 bytes per pixel (read-only)\n\ngray: output buffer + its width, via RowWidth ->\nused for the col check (2a) and the output spot (5)\n\nwidth: plain number -> used to linearize the input (3)\nheight: plain number -> used for the row check (2b) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
