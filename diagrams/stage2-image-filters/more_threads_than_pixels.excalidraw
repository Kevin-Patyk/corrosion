    },
    {
      "id": "VuOS2uBULA5AqIexPJ2bV",
      "type": "text",
      "x": 1723.8700485229492,
      "y": 449.5000002222222,
      "width": 171.75990295410156,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
