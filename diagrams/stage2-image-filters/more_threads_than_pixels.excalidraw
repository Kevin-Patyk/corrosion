    {
      "id": "WmAhgZHUDniQUdl6tjU9z",
      "type": "text",
      "x": 1090.6647642666017,
      "y": 211.40233899999996,
      "width": 342.5798034667969,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 305313949,
      "version": 612,
      "versionNonce": 664501597,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792069781119,
      "link": null,
      "locked": false,
      "text": "Block size = \n2x2 (4 threads)\n\nNumber of blocks across (x) =\ndiv_ceil(5/2) = 3\n\nNumber of blocks down (y) =\ndiv_ceil(3/2) = 2\n\nTotal number of blocks = 3x2 = 6\n\nTotal number of threads = \n6x4 = 24\n\nTotal number of threads needed = \n5x3 = 15\n\nNumber of extra threads = \n24 - 15 = 9",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Block size = \n2x2 (4 threads)\n\nNumber of blocks across (x) =\ndiv_ceil(5/2) = 3\n\nNumber of blocks down (y) =\ndiv_ceil(3/2) = 2\n\nTotal number of blocks = 3x2 = 6\n\nTotal number of threads = \n6x4 = 24\n\nTotal number of threads needed = \n5x3 = 15\n\nNumber of extra threads = \n24 - 15 = 9",
      "autoResize": true,
      "lineHeight": 1.25
    },
