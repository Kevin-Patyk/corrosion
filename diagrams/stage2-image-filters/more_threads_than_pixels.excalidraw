      "isDeleted": false,
      "boundElements": [],
      "updated": 1792070216154,
      "link": null,
      "locked": false,
      "text": "Red box = blocks.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Red box = blocks.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "H4DhRYICcxpi7ogiHUAwW",
      "type": "text",
      "x": 919.6376404433595,
      "y": 765.3472222222222,
      "width": 681.3196411132812,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 521744285,
      "version": 901,
      "versionNonce": 1402078757,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792411086352,
      "link": null,
      "locked": false,
      "text": "Mapping is just arithmetic (block x block size + position), so every\nthread gets a (row, col), even when that spot isn't in the picture.\n\nWe round up using div_ceil (one per direction), so the grid\nhas more threads than pixels: 3x2 blocks of 2x2 = 24 threads\nfor 15 pixels.\n\nThread (0, 5) works out col = 5 and thread (3, 0) works out row = 3,\nbut those spots don't exist. The bounds check stops them \nbefore they do any work.\n\nThe bounds check catches these: col < width stops the right column,\nrow < height stops the bottom row. They do nothing.\n\nWithout the check, they would read or write the wrong\nspot or past the end of memory.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mapping is just arithmetic (block x block size + position), so every\nthread gets a (row, col), even when that spot isn't in the picture.\n\nWe round up using div_ceil (one per direction), so the grid\nhas more threads than pixels: 3x2 blocks of 2x2 = 24 threads\nfor 15 pixels.\n\nThread (0, 5) works out col = 5 and thread (3, 0) works out row = 3,\nbut those spots don't exist. The bounds check stops them \nbefore they do any work.\n\nThe bounds check catches these: col < width stops the right column,\nrow < height stops the bottom row. They do nothing.\n\nWithout the check, they would read or write the wrong\nspot or past the end of memory.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
  "appState": {
    "gridSize": 20,
    "gridStep": 5,
    "gridModeEnabled": false,
    "viewBackgroundColor": "#ffffff"
  },
  "files": {}
}