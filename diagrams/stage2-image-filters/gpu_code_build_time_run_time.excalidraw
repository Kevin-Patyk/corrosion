    {
      "id": "d2gkzNtSdTDm3TcsJJ7Rn",
      "type": "text",
      "x": 453.130187654948,
      "y": 1066.9444441111111,
      "width": 603.7396240234375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 1999879934,
      "version": 992,
      "versionNonce": 772997026,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792500573095,
      "link": null,
      "locked": false,
      "text": "#[cuda_module] (build time) makes BOTH the PTX and Rust \nmethods.\n\nThe driver (run time) only turns PTX into code for the GPU\nin this machine.\n\nmodule = the kernel loaded on the GPU; the generated\nmethods work through it.\n\nPTX = NVIDIA's GPU assembly language, not tied\nto one exact GPU model.\n\nunsafe: we promise the PTX is from this module. ?: the driver\ncan refuse.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#[cuda_module] (build time) makes BOTH the PTX and Rust \nmethods.\n\nThe driver (run time) only turns PTX into code for the GPU\nin this machine.\n\nmodule = the kernel loaded on the GPU; the generated\nmethods work through it.\n\nPTX = NVIDIA's GPU assembly language, not tied\nto one exact GPU model.\n\nunsafe: we promise the PTX is from this module. ?: the driver\ncan refuse.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
