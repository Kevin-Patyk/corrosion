      "updated": 1792075033687,
      "link": null,
      "locked": false,
      "text": "Stride = how many spots to jump.\n\nThe big jump = length of what's stored in one piece.\n\nRow-major: a row is width long, so down = +width.\n\nColumn-major: a col is height long, so right = +height.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stride = how many spots to jump.\n\nThe big jump = length of what's stored in one piece.\n\nRow-major: a row is width long, so down = +width.\n\nColumn-major: a col is height long, so right = +height.",
      "autoResize": true,
      "lineHeight": 1.25
    }
