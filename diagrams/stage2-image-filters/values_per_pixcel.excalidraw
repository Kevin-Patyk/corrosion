    },
    {
      "id": "hpKDVTWkIKYUyljY7mrXY",
      "type": "text",
      "x": 442.96620673834286,
      "y": 591.6111109682541,
      "width": 529.69970703125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 1034011591,
      "version": 631,
      "versionNonce": 804437220,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791988567783,
      "link": null,
      "locked": false,
      "text": "Its first value is at 2 * 3 = 6, so R = 6, G = 7, B = 8",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Its first value is at 2 * 3 = 6, so R = 6, G = 7, B = 8",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VFsMJOLR4xKFpd44x3McV",
      "type": "text",
      "x": 359.96626705921335,
      "y": 638.7539682539683,
      "width": 695.6995849609375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 1398027081,
      "version": 752,
      "versionNonce": 1272021092,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791988567783,
      "link": null,
      "locked": false,
      "text": "Any color value: (row * width + col) * 3 + channel (R = 0, G = 1, B = 2).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Any color value: (row * width + col) * 3 + channel (R = 0, G = 1, B = 2).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FsjhMprgkNa304vHBZy7w",
      "type": "text",
      "x": 343.5977099780191,
      "y": 692.9365079682539,
      "width": 741.2794799804688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 1138437447,
      "version": 942,
      "versionNonce": 369873892,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791988567783,
      "link": null,
      "locked": false,
      "text": "Gray output is a separate list. A gray only needs one number, its brightness\n(0 = black, 255 = white), so there's 1 value per pixel.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gray output is a separate list. A gray only needs one number, its brightness\n(0 = black, 255 = white), so there's 1 value per pixel.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eLpVVT0dvCUAcsZhTU353",
      "type": "text",
      "x": 344.96802412171337,
      "y": 760.5396821111111,
      "width": 731.6195068359375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 1147966409,
      "version": 1120,
      "versionNonce": 1555019620,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791988567783,
      "link": null,
      "locked": false,
      "text": "The thread on pixel 2 reads spots 6, 7, 8, mixes them into one brightness,\nand writes its to spot 2.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The thread on pixel 2 reads spots 6, 7, 8, mixes them into one brightness,\nand writes its to spot 2.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qqTCQ4EkDOP0j6AR0UKhT",
      "type": "text",
      "x": 518.327568805028,
      "y": 828.1428558253967,
      "width": 391.81976318359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 2038825511,
      "version": 1214,
      "versionNonce": 2081106660,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791988567783,
      "link": null,
      "locked": false,
      "text": "So the gray formula is row * width + col",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So the gray formula is row * width + col",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "URgDNLX_diX446S0apIQx",
      "type": "text",
      "x": 366.8563123680858,
      "y": 881.5079359682543,
      "width": 681.9194946289062,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0h",
      "roundness": null,
      "seed": 604832329,
      "version": 1490,
      "versionNonce": 380382820,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791988567783,
      "link": null,
      "locked": false,
      "text": "Each thread is assigned one pixel, through the mapping.\nIn the input memory, the pixel is 3 values side by side: R, G, B.\nThe thread reads those 3 values and mixes them into one brightness.\nIt writes that single value to the output.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each thread is assigned one pixel, through the mapping.\nIn the input memory, the pixel is 3 values side by side: R, G, B.\nThe thread reads those 3 values and mixes them into one brightness.\nIt writes that single value to the output.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ylqUrfCm4YpPOGlj6FqBg",
      "type": "text",
      "x": 389.9679940508901,
      "y": 1028.9891820000003,
      "width": 641.6195678710938,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0i",
      "roundness": null,
      "seed": 864394852,
      "version": 1617,
      "versionNonce": 750383588,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791988611771,
      "link": null,
      "locked": false,
      "text": "For the gray step, the input is 3 values (R, G, B) and the output\nis one value per pixel.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For the gray step, the input is 3 values (R, G, B) and the output\nis one value per pixel.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
