    {
      "id": "GyObZYzYzuGS9EfTTxyKv",
      "type": "text",
      "x": -203.29986572265625,
      "y": 159.5,
      "width": 372.5997314453125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1826359431,
      "version": 326,
      "versionNonce": 1046813532,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "6wZYaGpSwqsYyXycJbMhO",
          "type": "arrow"
        }
      ],
      "updated": 1791990300791,
      "link": null,
      "locked": false,
      "text": "Mapping: which pixel is this thread on?\nIt gives (row, col), e.g. (1,0).\n\nLinearizing: Where is it in memory?\n1 * 2 + 0 = pixel 2. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mapping: which pixel is this thread on?\nIt gives (row, col), e.g. (1,0).\n\nLinearizing: Where is it in memory?\n1 * 2 + 0 = pixel 2. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sDwCUMeyx_OK54nNYpRwt",
      "type": "text",
      "x": -198.06982421875,
      "y": 306.3345719424118,
      "width": 370.1396484375,
      "height": 90.16542805758823,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1491236359,
      "version": 683,
      "versionNonce": 445765732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791990300791,
      "link": null,
      "locked": false,
      "text": "The global index formula (mapping) shows which pixel\nthe thread works on, as (row, col).\n\nThe linearizing formula shows where that pixel is\nin memory, as row * width + col",
      "fontSize": 14.426468489214107,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The global index formula (mapping) shows which pixel\nthe thread works on, as (row, col).\n\nThe linearizing formula shows where that pixel is\nin memory, as row * width + col",
      "autoResize": true,
      "lineHeight": 1.25
    },
