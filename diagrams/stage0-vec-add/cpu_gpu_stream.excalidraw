    {
      "id": "2fTbGxSE6lm5anlKAGOIh",
      "type": "text",
      "x": -155.8270565371094,
      "y": 486.46545100000003,
      "width": 273.15985107421875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
