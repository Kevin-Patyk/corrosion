      "roundness": null,
      "seed": 1732758907,
      "version": 1009,
      "versionNonce": 53660672,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791535415836,
      "link": null,
      "locked": false,
      "text": "col = block.x * 16 + position.x\nrow = block.y * 16 + position.y",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "col = block.x * 16 + position.x\nrow = block.y * 16 + position.y",
      "autoResize": true,
      "lineHeight": 1.25
    },
