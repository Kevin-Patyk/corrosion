      "type": "text",
      "x": 99.71765948437513,
      "y": 824.4971169091798,
      "width": 444.69976806640625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 1311606491,
      "version": 846,
      "versionNonce": 1040534528,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791535415836,
      "link": null,
      "locked": false,
      "text": "index = row * (row stride) + col * (col stride)\n= row * width + col * 1\n= row * 4 + col",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "index = row * (row stride) + col * (col stride)\n= row * width + col * 1\n= row * 4 + col",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mc5tTaOZD-Hle769jRVUW",
      "type": "text",
      "x": 156.54643412792984,
      "y": 705.8521130185545,
      "width": 327.6997985839844,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 1382247675,
      "version": 921,
      "versionNonce": 1736166400,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791535415836,
      "link": null,
      "locked": false,
      "text": "Strides:\ncolumn stride = 1 (next col: +1)\nrow stride = width (next row: +4)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Strides:\ncolumn stride = 1 (next col: +1)\nrow stride = width (next row: +4)",
      "autoResize": true,
      "lineHeight": 1.25
    },
