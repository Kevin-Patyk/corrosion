      "link": null,
      "locked": false,
      "text": "MAPPING (fast): x goes into COL\n= the usual CUDA convention (x = col)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MAPPING (fast): x goes into COL\n= the usual CUDA convention (x = col)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3r009eUrfrfOgjNeLnCax",
      "type": "text",
      "x": 169.5972962175291,
      "y": 1075.3884150393062,
      "width": 293.37982177734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
