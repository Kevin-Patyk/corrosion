      "text": "index = row * (row stride) + col * (col stride)\n= row * 1 + col * height\n= row + col * 3",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "index = row * (row stride) + col * (col stride)\n= row * 1 + col * height\n= row + col * 3",
      "autoResize": true,
      "lineHeight": 1.25
    },
