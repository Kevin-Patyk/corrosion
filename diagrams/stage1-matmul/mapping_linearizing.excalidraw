      "seed": 189621189,
      "version": 1053,
      "versionNonce": 1144801925,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791550367961,
      "link": null,
      "locked": false,
      "text": "block width = 2, block height = 2\n\ncol = block.x * block width + position.x = \n1 * 2 + 0 = 2\n\nrow = block.y * block height + position.y =\n0 * 2 + 1 = 1",
      "fontSize": 17.609222785430017,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
