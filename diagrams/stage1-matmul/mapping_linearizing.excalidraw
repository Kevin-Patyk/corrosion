      "type": "text",
      "x": 250.54283691646538,
      "y": -19.33706438024734,
      "width": 359.0870797293528,
      "height": 154.08069937251258,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
