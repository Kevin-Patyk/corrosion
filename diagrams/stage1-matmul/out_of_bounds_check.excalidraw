      "type": "text",
      "x": 508.47623867458765,
      "y": 406.48611067676893,
      "width": 338.269744873047,
      "height": 191.70505643434223,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
