    },
    {
      "id": "_xATt1VpOxF4FSQ-BXnMw",
      "type": "text",
      "x": 628.5813558567165,
      "y": 688.3611111111111,
      "width": 779.259521484375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 161769426,
      "version": 277,
      "versionNonce": 688733198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791798678015,
      "link": null,
      "locked": false,
      "text": "Too far right -> WRONG ELEMENT\nwraps into the next row: (0, 3) -> spot 3 = (1,0). No error, just a wrong answer.\nCaught by index_2d (gives None).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Too far right -> WRONG ELEMENT\nwraps into the next row: (0, 3) -> spot 3 = (1,0). No error, just a wrong answer.\nCaught by index_2d (gives None).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TlS-NuqR51I7rF9l9gdDq",
      "type": "text",
      "x": 663.8457867341581,
      "y": 789.371722111111,
      "width": 733.9995727539062,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 2080116878,
      "version": 487,
      "versionNonce": 120633490,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791798760680,
      "link": null,
      "locked": false,
      "text": "Too far down -> OFF THE END\npast the last spot: (3,0) -> spot 9, last spot is 9. Memory that isn't ours.\nCaught by our own check (row < WIDTH).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Too far down -> OFF THE END\npast the last spot: (3,0) -> spot 9, last spot is 9. Memory that isn't ours.\nCaught by our own check (row < WIDTH).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "V7Nm3XbQRofD_w0uScIP5",
      "type": "text",
      "x": 642.3079799411894,
      "y": 891.7712231111111,
      "width": 790.5995483398438,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 1367714702,
      "version": 661,
      "versionNonce": 645127378,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791798793858,
      "link": null,
      "locked": false,
      "text": "Exception: last row of the matrix (2,3) is too far right, but there's no next row\nto wrap into: 2*3+3 = 9, so it goes OFF THE END too.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exception: last row of the matrix (2,3) is too far right, but there's no next row\nto wrap into: 2*3+3 = 9, so it goes OFF THE END too.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lELFr8GKAkfCOAKnPZEVO",
      "type": "text",
      "x": 659.1079982517363,
      "y": 969.1707241111111,
      "width": 756.99951171875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0s",
      "roundness": null,
      "seed": 740713166,
      "version": 773,
      "versionNonce": 194690322,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791798812006,
      "link": null,
      "locked": false,
      "text": "Wrong element is the sneaky one: silent. Check both bounds before linearizing.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wrong element is the sneaky one: silent. Check both bounds before linearizing.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TYku2s-kLZY6yqB3B7Zx4",
      "type": "text",
      "x": 688.5480006931425,
      "y": 1021.7434441111109,
      "width": 705.6195068359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 667927186,
      "version": 952,
      "versionNonce": 1797421774,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791798862160,
      "link": null,
      "locked": false,
      "text": "The 4x4 grid is four 2x2 blocks: they splot after col 1 and after row 1.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The 4x4 grid is four 2x2 blocks: they splot after col 1 and after row 1.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_R7SgnEGCNr-pWY_lZOCF",
      "type": "text",
      "x": 645.8658663415797,
      "y": 1087.8823331111112,
      "width": 798.3394775390625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 1885182994,
      "version": 1427,
      "versionNonce": 917778446,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791806219699,
      "link": null,
      "locked": false,
      "text": "Map -> bounds check -> linearize\nGrid rounds up to the whole blocks: more threads than matrix elements. \nMapping is just arithmetic, so every thread gets a (row, col), even off the matrix.\nBounds check BEFORE linearizing. Threads outside the matrix do nothing.\nWithout it:\ncol too big -> wrong element (silent)\nrow too big -> past the end of the array\nindex_2d::<WIDTH> checks col, we check row ourselves.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Map -> bounds check -> linearize\nGrid rounds up to the whole blocks: more threads than matrix elements. \nMapping is just arithmetic, so every thread gets a (row, col), even off the matrix.\nBounds check BEFORE linearizing. Threads outside the matrix do nothing.\nWithout it:\ncol too big -> wrong element (silent)\nrow too big -> past the end of the array\nindex_2d::<WIDTH> checks col, we check row ourselves.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
  "appState": {
    "gridSize": 20,
    "gridStep": 5,
    "gridModeEnabled": false,
    "viewBackgroundColor": "#ffffff"
  },
  "files": {}
}