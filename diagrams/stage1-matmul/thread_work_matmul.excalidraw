      "locked": false,
      "text": "3. WHAT IT WRITES",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. WHAT IT WRITES",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ioIuBEsOZFN-B1f8ekx1r",
      "type": "text",
      "x": 1420.0670606171875,
      "y": 75.43876165917968,
      "width": 410.31982421875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 672462360,
      "version": 1876,
      "versionNonce": 276601518,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791535554188,
      "link": null,
      "locked": false,
      "text": "C[1][2] = a0*b0 + a1*b1 + a2*b2 + a3*b3",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C[1][2] = a0*b0 + a1*b1 + a2*b2 + a3*b3",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "J9KGenRF7IcWyhOJmgp1G",
      "type": "text",
      "x": 1444.2565199082037,
      "y": 204.45299742480466,
      "width": 364.77972412109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 187926120,
      "version": 2052,
      "versionNonce": 800134382,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791535554188,
      "link": null,
      "locked": false,
      "text": "In general, for k = 0 .. N-1:\nC[row][col] =+ A[row][k] * B[k][col]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In general, for k = 0 .. N-1:\nC[row][col] =+ A[row][k] * B[k][col]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ULnJqHyAicdElm6_lzpLl",
      "type": "rectangle",
      "x": 307.81674188085935,
      "y": 534.4247695585937,
      "width": 1050.2425680000001,
      "height": 384.59533691406256,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 90776168,
      "version": 230,
      "versionNonce": 868236398,
      "isDeleted": false,
