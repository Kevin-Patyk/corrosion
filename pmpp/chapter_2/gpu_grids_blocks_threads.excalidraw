    {
      "id": "siYxN4DxaALUdVjs4ARps",
      "type": "text",
      "x": 583.1363204511719,
      "y": 575.213612,
      "width": 782.3994750976562,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 277775116,
      "version": 1245,
      "versionNonce": 1040727604,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790346377095,
      "link": null,
      "locked": false,
      "text": "All blocks of a grid are the same size.\n\nEach block can contain up to 1024 threads on\ncurrent systems.\n\nThe total # of blocks in the grid and the total # of\nthreads in each block is specified by the host code when a\nkernel is called.\n\nThe same kernel can be called with different #s of blocks\nand threads in different parts of host code.\n\nIn general, it is recommended that the total number\nof threads in a thread block is a multiple of 32 for hardware efficiency reasons.\n\nWhen picking a block size, launch enough blocks that (blocks x block size) >= N.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "All blocks of a grid are the same size.\n\nEach block can contain up to 1024 threads on\ncurrent systems.\n\nThe total # of blocks in the grid and the total # of\nthreads in each block is specified by the host code when a\nkernel is called.\n\nThe same kernel can be called with different #s of blocks\nand threads in different parts of host code.\n\nIn general, it is recommended that the total number\nof threads in a thread block is a multiple of 32 for hardware efficiency reasons.\n\nWhen picking a block size, launch enough blocks that (blocks x block size) >= N.",
      "autoResize": true,
      "lineHeight": 1.25
    },
