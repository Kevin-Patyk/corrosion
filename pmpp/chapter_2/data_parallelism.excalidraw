      "text": "The chunks are already in place;\nno merge step needed",
      "fontSize": 16.20197076016854,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The chunks are already in place;\nno merge step needed",
