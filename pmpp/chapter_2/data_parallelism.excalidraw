    {
      "id": "8Wdr86MLEUP9oNRu08vhz",
      "type": "text",
      "x": 96.12372193549942,
      "y": 835.429225667845,
      "width": 553.2489169326612,
      "height": 45.25590346292176,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 2028988561,
      "version": 1474,
      "versionNonce": 1815453233,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790339806924,
      "link": null,
      "locked": false,
      "text": "Nothing crosses between columns. Worker i only ever touches\nits own chunk of A, B, and C, so all four run at the same time.",
      "fontSize": 18.102361385168702,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nothing crosses between columns. Worker i only ever touches\nits own chunk of A, B, and C, so all four run at the same time.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4Yj5f6ASUfaRD1hXmrG1t",
      "type": "text",
      "x": 731.3501579991939,
      "y": 366.6940412073411,
      "width": 393.3197021484375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffd8a8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1061692031,
      "version": 355,
      "versionNonce": 1696903185,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790339806924,
      "link": null,
      "locked": false,
      "text": "Data parallelism assumes independence: \noperations can be executed on individual\nchunks without depending on any other\nchunk or its result. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data parallelism assumes independence: \noperations can be executed on individual\nchunks without depending on any other\nchunk or its result. ",
      "autoResize": true,
      "lineHeight": 1.25
    }
