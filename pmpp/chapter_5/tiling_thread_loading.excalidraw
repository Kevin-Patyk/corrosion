      "isDeleted": false,
      "boundElements": [],
      "updated": 1795612573079,
      "link": null,
      "locked": false,
      "text": "Which rows of A, which columns of B: set by where the block's spots of C are.\nThey never change. Which columns of A, which rows of B: set by the phase.\nThey move together.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Which rows of A, which columns of B: set by where the block's spots of C are.\nThey never change. Which columns of A, which rows of B: set by the phase.\nThey move together.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
