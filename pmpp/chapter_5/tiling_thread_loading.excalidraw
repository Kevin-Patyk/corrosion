      "updated": 1795612737482,
      "link": null,
      "locked": false,
      "text": "TL: A(0,0), B(0,2) | TR: A(0,1), B(0,3)\nBL: A(1,0), B(1,2) | BR: A(1,1), B(1,3)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TL: A(0,0), B(0,2) | TR: A(0,1), B(0,3)\nBL: A(1,0), B(1,2) | BR: A(1,1), B(1,3)",
      "autoResize": true,
      "lineHeight": 1.25
    },
