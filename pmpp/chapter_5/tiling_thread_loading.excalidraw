      "boundElements": [],
      "updated": 1795611982217,
      "link": null,
      "locked": false,
      "text": "Its 4 threads, by position in the block:",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Its 4 threads, by position in the block:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_ZHcaS5wVJyDvYj4tcJo6",
      "type": "text",
      "x": 851.4721069335938,
      "y": 281.04325400000005,
      "width": 245.0557861328125,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 262914608,
      "version": 479,
      "versionNonce": 857506000,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795612024033,
      "link": null,
      "locked": false,
      "text": "TL = top-left, owns C(0,2)\nTR = top-right, owns C(0,3)\nBL = bottom-left, owns C(1,2)\nBR = bottom-right, owns C(1,3)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TL = top-left, owns C(0,2)\nTR = top-right, owns C(0,3)\nBL = bottom-left, owns C(1,2)\nBR = bottom-right, owns C(1,3)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5_CyzFoq01-7l6oIHfYws",
      "type": "text",
      "x": 444.4964443125,
      "y": 461.543253,
      "width": 734.943359375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 841249488,
      "version": 726,
      "versionNonce": 855992528,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795612065200,
      "link": null,
      "locked": false,
      "text": "The rule: each thread loads the value at its position in the tile.\nTL loads the tile's top-left, TR its top-right, and so on. What changes is where the tile sits.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The rule: each thread loads the value at its position in the tile.\nTL loads the tile's top-left, TR its top-right, and so on. What changes is where the tile sits.",
      "autoResize": true,
      "lineHeight": 1.25
    },
