      "isDeleted": false,
      "boundElements": [],
      "updated": 1795613433865,
      "link": null,
      "locked": false,
      "text": "TL loads only 2 values of A and 2 of B. C(0,2) needs all of row 0 of A and column 2 of B.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TL loads only 2 values of A and 2 of B. C(0,2) needs all of row 0 of A and column 2 of B.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wGGCiEAnyW40-_1zwUGcv",
      "type": "text",
      "x": 530.55349894828,
      "y": 1972.1998887142847,
      "width": 663.0075073242188,
      "height": 40,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2b",
      "roundness": null,
      "seed": 919288016,
      "version": 757,
      "versionNonce": 1644292816,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795613469818,
      "link": null,
      "locked": false,
      "text": "The rest is loaded by its neighbours: A(0,1), A(0,3) by TR, and B(1,2), B(3,2) by BL.\nTL reads those from shared memory.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The rest is loaded by its neighbours: A(0,1), A(0,3) by TR, and B(1,2), B(3,2) by BL.\nTL reads those from shared memory.",
      "autoResize": true,
      "lineHeight": 1.25
    },
