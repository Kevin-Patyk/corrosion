    {
      "id": "HiJuikd_Un4tvBq-F7ckw",
      "type": "text",
      "x": 553.5921752109375,
      "y": 914,
      "width": 522.655517578125,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 420503473,
      "version": 845,
      "versionNonce": 1083308767,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795616782731,
      "link": null,
      "locked": false,
      "text": "Every phase is the same 4 steps: load, barrier, compute barrier.\nOnly which piece of A and B gets loaded changes.\n\nFirst barrier: nobody computes until every slot is filled.\nSecond barrier: nobody loads the next piece while others still read.\n\nThe running total stays in a register the whole time.\nIt goes to C only once, at the very end.\n\nRule of thumb: load, wait, compute, wait. Repeat per phase,\nthen write once.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every phase is the same 4 steps: load, barrier, compute barrier.\nOnly which piece of A and B gets loaded changes.\n\nFirst barrier: nobody computes until every slot is filled.\nSecond barrier: nobody loads the next piece while others still read.\n\nThe running total stays in a register the whole time.\nIt goes to C only once, at the very end.\n\nRule of thumb: load, wait, compute, wait. Repeat per phase,\nthen write once.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
