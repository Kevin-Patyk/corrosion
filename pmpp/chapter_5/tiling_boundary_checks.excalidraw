    {
      "id": "LyiHg14ytCPadFADy0AWt",
      "type": "text",
      "x": 462.1301032773439,
      "y": 1296.4705900000001,
      "width": 654.9434814453125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1r",
      "roundness": null,
      "seed": 1153051110,
      "version": 614,
      "versionNonce": 1122616934,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795535363386,
      "link": null,
      "locked": false,
      "text": "Even thread (0,1) whose spot C(0,1) is real, would load A(0,3). So it puts 0 instead.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Even thread (0,1) whose spot C(0,1) is real, would load A(0,3). So it puts 0 instead.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t_uQ0AvT9pOBPbvNxzdGu",
      "type": "text",
      "x": 470.2064786113282,
      "y": 1323.5622839999999,
      "width": 626.8954467773438,
      "height": 20,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1s",
      "roundness": null,
      "seed": 1315594214,
      "version": 735,
      "versionNonce": 1676675494,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795535363386,
      "link": null,
      "locked": false,
      "text": "0 x anything = 0, so it adds nothing to anyone's total. The answer stays right.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "0 x anything = 0, so it adds nothing to anyone's total. The answer stays right.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WxgUm2iTGTV3dJK7r-kVY",
      "type": "text",
      "x": 1141.1349087333983,
      "y": 1101.475779,
      "width": 79.26394653320312,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1t",
      "roundness": null,
      "seed": 428736486,
      "version": 708,
      "versionNonce": 1774970086,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795535363386,
      "link": null,
      "locked": false,
      "text": "Copy of B",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Copy of B",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6mfIsghq-vMxbQaSnOwDj",
      "type": "text",
      "x": 361.4569621035156,
      "y": 1366.802769,
      "width": 863.4874877929688,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1u",
      "roundness": null,
      "seed": 1690579130,
      "version": 842,
      "versionNonce": 1443518502,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795535363386,
      "link": null,
      "locked": false,
      "text": "A and B themselves aren't changed. The 0s only go into the slots of the 2x2 tiles (the shared memory copy),\nso global memory still holds the plain 3x3 matrices.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A and B themselves aren't changed. The 0s only go into the slots of the 2x2 tiles (the shared memory copy),\nso global memory still holds the plain 3x3 matrices.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YgcjY6z1Yu3-HP15_Da6R",
      "type": "text",
      "x": 1226.4291743691406,
      "y": 273.173011,
      "width": 413.29559326171875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1v",
      "roundness": null,
      "seed": 186218426,
      "version": 1077,
      "versionNonce": 101300986,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795535350601,
      "link": null,
      "locked": false,
      "text": "With tiling, threads outside C still do real work: they\nload their share of the tiles (a real value or a 0) for\nthe other threads in the block. So they can't stop\nearly; they reach every barrier and only skip \nthe write to C.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "With tiling, threads outside C still do real work: they\nload their share of the tiles (a real value or a 0) for\nthe other threads in the block. So they can't stop\nearly; they reach every barrier and only skip \nthe write to C.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MkcDiyiN4MyVKyq9rpvBd",
      "type": "text",
      "x": 514.4949679335939,
      "y": 1444.2923889999997,
      "width": 603.3995361328125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1w",
      "roundness": null,
      "seed": 1748451814,
      "version": 509,
      "versionNonce": 215141626,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795535393078,
      "link": null,
      "locked": false,
      "text": "4. Check when writing: only threads with a spot inside C write",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Check when writing: only threads with a spot inside C write",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hyzvw8RL0piYZ6Zdq_5m7",
      "type": "text",
      "x": 449.96298551171867,
      "y": 1478.335651,
      "width": 732.4635009765625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1x",
      "roundness": null,
      "seed": 67318118,
      "version": 1180,
      "versionNonce": 1011229498,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795535423740,
      "link": null,
      "locked": false,
      "text": "Block (1,1), phase 0. It owns 4 spots, but only C(2,2) exists. Problems happen in every phase.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Block (1,1), phase 0. It owns 4 spots, but only C(2,2) exists. Problems happen in every phase.",
      "autoResize": true,
      "lineHeight": 1.25
    },
