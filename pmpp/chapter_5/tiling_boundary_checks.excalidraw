      "isDeleted": false,
      "boundElements": [],
      "updated": 1795532380238,
      "link": null,
      "locked": false,
      "text": "Purple = threads that own a spot of C.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Purple = threads that own a spot of C.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VV95XyJxOnRgZnlA1ithV",
      "type": "text",
      "x": 766.6239929589843,
      "y": 308.629758,
      "width": 358.46368408203125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 741111270,
      "version": 547,
      "versionNonce": 325516474,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795532405274,
      "link": null,
      "locked": false,
      "text": "Gray dashed = threads whose spot is outside\nC (there is no row 3 or col 3).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gray dashed = threads whose spot is outside\nC (there is no row 3 or col 3).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pQ3xL0C9rjn0rKBVQ2v7t",
      "type": "text",
      "x": 766.6239929746095,
      "y": 390.04325300000005,
      "width": 431.27960205078125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1464581882,
      "version": 713,
      "versionNonce": 878076838,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795532533071,
      "link": null,
      "locked": false,
      "text": "The tiles that stick out of A and B are the same way.\nThey have the same problem as the blocks, meaning\nthey are also 2x2.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The tiles that stick out of A and B are the same way.\nThey have the same problem as the blocks, meaning\nthey are also 2x2.",
      "autoResize": true,
      "lineHeight": 1.25
    },
