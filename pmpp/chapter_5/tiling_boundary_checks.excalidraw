      "updated": 1795533708204,
      "link": null,
      "locked": false,
      "text": "Past the end of row: \"A(0, 3)\" does not exist, so its address lands on A(1,0).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Past the end of row: \"A(0, 3)\" does not exist, so its address lands on A(1,0).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9aQlDiSUzyc4RoWBY2pfB",
      "type": "text",
      "x": 572.0589632949217,
      "y": 778.216261,
      "width": 488.27154541015625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 1729192442,
      "version": 838,
      "versionNonce": 1481575290,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795533601436,
      "link": null,
      "locked": false,
      "text": "A real value, but the wrong one. No error, just a wrong answer.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A real value, but the wrong one. No error, just a wrong answer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rDGZdhGIIXK2ilBp_Ypjr",
      "type": "text",
      "x": 531.3869357070312,
      "y": 822.0484379999999,
      "width": 569.6156005859375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 2025145786,
      "version": 573,
      "versionNonce": 536211686,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795533635798,
      "link": null,
      "locked": false,
      "text": "Past the end of the column: \"B(3,0)\" is past the end of the whole array.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Past the end of the column: \"B(3,0)\" is past the end of the whole array.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "67Ipgn38in4KYoo6PjgqQ",
      "type": "text",
      "x": 629.9991444667971,
      "y": 851.6055369999999,
      "width": 387.87164306640625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 600711674,
      "version": 916,
      "versionNonce": 2271270,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795533648708,
      "link": null,
      "locked": false,
      "text": "Garbage from other data or the program crashes.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Garbage from other data or the program crashes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XI8WQmiSH8UViIqrwUK7H",
      "type": "text",
      "x": 452.41098355859367,
      "y": 891.8892739999999,
      "width": 727.5675048828125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 1478720314,
      "version": 927,
      "versionNonce": 455877306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795533827376,
      "link": null,
      "locked": false,
      "text": "A, B, and C are stored as one long list. Without tiling, one check on C is enough, because\na thread inside C only reads values that exist. With tiling, even a thread inside C can \ntry to read outside A or B, so loading A, loading B, and writing C each need their own check.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A, B, and C are stored as one long list. Without tiling, one check on C is enough, because\na thread inside C only reads values that exist. With tiling, even a thread inside C can \ntry to read outside A or B, so loading A, loading B, and writing C each need their own check.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qlgaFpgO_UcwPdR3RaQXF",
      "type": "text",
      "x": 532.874881263672,
      "y": 974.394464,
      "width": 566.6397094726562,
      "height": 25,
      "angle": 0,
