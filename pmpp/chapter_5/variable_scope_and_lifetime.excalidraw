      "updated": 1794909586583,
      "link": null,
      "locked": false,
      "text": "Declared inside the kernel = one kernel run. Declared outside any function = whole program.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Declared inside the kernel = one kernel run. Declared outside any function = whole program.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cwd1WxrPDfwsac3W2bC1J",
      "type": "rectangle",
      "x": 115.70981087500002,
      "y": 932.4638671875,
      "width": 930.0694859375,
      "height": 236.20605431250002,
      "angle": 0,
      "strokeColor": "#f08c00",
