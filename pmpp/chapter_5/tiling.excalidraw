      "text": "Barrier. Load the next pair over the old one. Barrier. Compute again, adding\nthe same running totals.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Barrier. Load the next pair over the old one. Barrier. Compute again, adding\nthe same running totals.",
      "autoResize": true,
      "lineHeight": 1.25
    },
