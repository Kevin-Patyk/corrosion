    {
      "id": "RTmf8CHcjZIzagjWkhNjU",
      "type": "text",
      "x": 439.9701843261719,
      "y": 191,
      "width": 684.0596313476562,
      "height": 375,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1414975261,
      "version": 721,
      "versionNonce": 805585309,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795689520391,
      "link": null,
      "locked": false,
      "text": "Refresher: the four pools of one SM on my RTX 5060 Ti\n\nThread seats: 1,536 (=48 warps). Every thread of a block needs one.\n\nBlock seats: 24. Every block takes one, however small it is.\n\nRegisters: 65,536. Each thread's own variables, like its running total.\nA block uses threads x registers per thread.\n\nShared memory: 100 KiB, at most 48 KiB per block. The tiles live here.\nA block uses whatever its kernel declares.\n\nA block lands on an SM only when all four pools have room for it.\nBlocks that fit = the smallest of the four. Occupancy =\nresident threads / 1,536.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Refresher: the four pools of one SM on my RTX 5060 Ti\n\nThread seats: 1,536 (=48 warps). Every thread of a block needs one.\n\nBlock seats: 24. Every block takes one, however small it is.\n\nRegisters: 65,536. Each thread's own variables, like its running total.\nA block uses threads x registers per thread.\n\nShared memory: 100 KiB, at most 48 KiB per block. The tiles live here.\nA block uses whatever its kernel declares.\n\nA block lands on an SM only when all four pools have room for it.\nBlocks that fit = the smallest of the four. Occupancy =\nresident threads / 1,536.",
      "autoResize": true,
      "lineHeight": 1.25
    },
