      "updated": 1795689069399,
      "link": null,
      "locked": false,
      "text": "RTX 5060 Ti per SM: 1536 thread seats, 24 block seats, 65,536 registers, 100 KiB shared.\nCard numbers verified: 32 registers per thread is made-up.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RTX 5060 Ti per SM: 1536 thread seats, 24 block seats, 65,536 registers, 100 KiB shared.\nCard numbers verified: 32 registers per thread is made-up.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ntNFe8oVxpwu7j8iLKX0f",
