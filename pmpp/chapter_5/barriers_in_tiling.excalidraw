      "seed": 1846949599,
      "version": 593,
      "versionNonce": 1051597535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795097513776,
      "link": null,
      "locked": false,
      "text": "A slot = one placed in shared memory that holds on value. It starts empty.\nT0 copies value 0 of A1 from global memory into slot 0: that is \"filling\" it.\nT0 also needs slot 1, but T1 is the on who wills it (B works the same way).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A slot = one placed in shared memory that holds on value. It starts empty.\nT0 copies value 0 of A1 from global memory into slot 0: that is \"filling\" it.\nT0 also needs slot 1, but T1 is the on who wills it (B works the same way).",
      "autoResize": true,
      "lineHeight": 1.25
    },
