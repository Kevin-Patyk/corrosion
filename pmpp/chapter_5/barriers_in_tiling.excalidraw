    {
      "id": "DpHw48QeQh2h4e_U3TmrU",
      "type": "text",
      "x": 405.3261274719126,
      "y": 1553.6666672698414,
      "width": 669.6995849609375,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 572449663,
      "version": 1490,
      "versionNonce": 1396614353,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795098736419,
      "link": null,
      "locked": false,
      "text": "A1 is a piece of the input A. It stays in global memory, unchanged.\nA slot is one place in shared memory that holds a copy of one value.\n\nEach thread fills one slot (copies on value from global into it), \nbut reads slots that other threads filled.\n\nThreads of a block do not all run in step: a block has several warps,\nand warps run at different times. T0 and T1 stand for threads in\ndifferent warps.\n\nA barrier is a \"wait here\" line: no thread goes past it until\nevery thread of the block has arrived.\n\nEach phase has two. After loading: nobody reads an empty slot.\nAfter computing: nobody overwrites a slot someone still needs.\n\nRule of thumb: when threads use each other's shared memory writes,\nput a barrier between the writing and the reading.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A1 is a piece of the input A. It stays in global memory, unchanged.\nA slot is one place in shared memory that holds a copy of one value.\n\nEach thread fills one slot (copies on value from global into it), \nbut reads slots that other threads filled.\n\nThreads of a block do not all run in step: a block has several warps,\nand warps run at different times. T0 and T1 stand for threads in\ndifferent warps.\n\nA barrier is a \"wait here\" line: no thread goes past it until\nevery thread of the block has arrived.\n\nEach phase has two. After loading: nobody reads an empty slot.\nAfter computing: nobody overwrites a slot someone still needs.\n\nRule of thumb: when threads use each other's shared memory writes,\nput a barrier between the writing and the reading.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
