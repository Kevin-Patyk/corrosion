    },
    {
      "id": "p6StMb9J3VGxOq7Hslb-y",
      "type": "text",
      "x": 1179.6046003611114,
      "y": 743.0000004444446,
      "width": 594.6796875,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 74450033,
      "version": 711,
      "versionNonce": 1937825094,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795429726415,
      "link": null,
      "locked": false,
      "text": "A1 = a piece of the input A. It lives in global memory.\nSlot = one place in shared memory that holds one value.\nT0 to T3 = the 4 threads of one block. Each does 2 jobs.\n\nJob 1, load: copy on value from global memory into one slot.\nBarrier: wait until all the slots are filled.\n\nJob 2, compute: read the slots it needs from shared memory.\nBarrier: wait until every thread has finished reading.\n\nThen the block's threads load the next two tiles it needs\n(A2 and B2) into the same slots, replacing A1 and B1.\n\nOther blocks never touch these slots: each block\nhas its own slice of shared memory.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A1 = a piece of the input A. It lives in global memory.\nSlot = one place in shared memory that holds one value.\nT0 to T3 = the 4 threads of one block. Each does 2 jobs.\n\nJob 1, load: copy on value from global memory into one slot.\nBarrier: wait until all the slots are filled.\n\nJob 2, compute: read the slots it needs from shared memory.\nBarrier: wait until every thread has finished reading.\n\nThen the block's threads load the next two tiles it needs\n(A2 and B2) into the same slots, replacing A1 and B1.\n\nOther blocks never touch these slots: each block\nhas its own slice of shared memory.",
      "autoResize": true,
      "lineHeight": 1.25
    },
