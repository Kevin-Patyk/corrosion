    {
      "id": "nLxJiCHcqiX9uNkwSwxIY",
      "type": "text",
      "x": 451.7662056514756,
      "y": 1440.7500004444444,
      "width": 542.2874755859375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 1920544881,
      "version": 782,
      "versionNonce": 734969535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795098153801,
      "link": null,
      "locked": false,
      "text": "Without a barrier, T1 reads the wrong value. With one, T0 waits until\nall 4 threads have finished computing, then the next pair is loaded.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Without a barrier, T1 reads the wrong value. With one, T0 waits until\nall 4 threads have finished computing, then the next pair is loaded.",
      "autoResize": true,
      "lineHeight": 1.25
    },
