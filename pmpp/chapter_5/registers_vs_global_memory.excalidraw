      "seed": 157173277,
      "version": 317,
      "versionNonce": 502543741,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794839636201,
      "link": null,
      "locked": false,
      "text": "fadd = floating-point add. It means r1 = r2 + r3\nBoth inputs are already in registers, so the core can add them right away.\n1 instruction, no waiting.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fadd = floating-point add. It means r1 = r2 + r3\nBoth inputs are already in registers, so the core can add them right away.\n1 instruction, no waiting.",
      "autoResize": true,
      "lineHeight": 1.25
    },
