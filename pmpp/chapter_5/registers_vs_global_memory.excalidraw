    {
      "id": "rzGef3QJrJBuUmMAMhUTW",
      "type": "text",
      "x": 419.12628206640625,
      "y": 480,
      "width": 582.9754638671875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
