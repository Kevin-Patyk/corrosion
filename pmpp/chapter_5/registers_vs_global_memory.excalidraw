      "isDeleted": false,
      "boundElements": [],
      "updated": 1794839994276,
      "link": null,
      "locked": false,
      "text": "The same two steps, but this load has to leave the chip.\nThe thread cannot do its add until the value arrives from global memory.\n2 instructions, long wait.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The same two steps, but this load has to leave the chip.\nThe thread cannot do its add until the value arrives from global memory.\n2 instructions, long wait.",
      "autoResize": true,
      "lineHeight": 1.25
    },
