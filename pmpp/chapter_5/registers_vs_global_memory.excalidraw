      "text": "Shared memory (on-chip, shared by block): the value starts here",
      "fontSize": 15.098518260329602,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Shared memory (on-chip, shared by block): the value starts here",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dIp2cx4JDGukReTvM0X9i",
      "type": "text",
      "x": 449.14218919531254,
      "y": 741.5,
      "width": 579.839599609375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1668964979,
      "version": 557,
      "versionNonce": 1360114451,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794839884664,
      "link": null,
      "locked": false,
      "text": "The value is not in a register yet, so the core must fetch it first.\nLoad copies it from shared memory into register r2. Then fadd can use it.\n2 instructions, short wait: shared memory is on the same chip.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The value is not in a register yet, so the core must fetch it first.\nLoad copies it from shared memory into register r2. Then fadd can use it.\n2 instructions, short wait: shared memory is on the same chip.",
      "autoResize": true,
      "lineHeight": 1.25
    },
