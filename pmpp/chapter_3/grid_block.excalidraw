      "updated": 1790674535606,
      "link": null,
      "locked": false,
      "text": "1D launch = a row of blocks\n2D launch = a sheet of blocks\n3d launch = a cube of blocks",
      "fontSize": 15.790625,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1D launch = a row of blocks\n2D launch = a sheet of blocks\n3d launch = a cube of blocks",
