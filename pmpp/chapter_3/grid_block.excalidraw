      ],
      "updated": 1790673463080,
      "link": null,
      "locked": false,
      "text": "Each + is a thread.\nThreads all execute the same kernel function.\nAll threads in the same block share the same block index.\nEach thread also has a thread index.\n",
      "fontSize": 15.790625,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each + is a thread.\nThreads all execute the same kernel function.\nAll threads in the same block share the same block index.\nEach thread also has a thread index.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
