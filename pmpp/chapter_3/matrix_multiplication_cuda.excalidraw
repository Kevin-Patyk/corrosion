      "updated": 1791297395813,
      "link": null,
      "locked": false,
      "text": "3. sum = 0\nfor k in 0..Width:\nsum += M[row*Width + k] * N[k*Width + col)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. sum = 0\nfor k in 0..Width:\nsum += M[row*Width + k] * N[k*Width + col)",
      "autoResize": true,
      "lineHeight": 1.25
    },
