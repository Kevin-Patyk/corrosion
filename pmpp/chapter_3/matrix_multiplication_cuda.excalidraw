    {
      "id": "be6Run7MFmeuXR0rtLh4U",
      "type": "text",
      "x": 416.8250883105004,
      "y": 1121.2857147142859,
      "width": 281.5998229980469,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
      "roundness": null,
      "seed": 232003530,
      "version": 1113,
      "versionNonce": 1474163286,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791296782342,
      "link": null,
      "locked": false,
      "text": "The loop, k = 0, 1, 2, 3:\n\nk = 0: M[1][0] x N[0][2]\nk = 1: M[1][1] x N[1][2]\nk = 2: M[1][2] x N[2][2]\n k = 3 M[1][3] x N[3][2] \n\nThen add all four -> P[1][2]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The loop, k = 0, 1, 2, 3:\n\nk = 0: M[1][0] x N[0][2]\nk = 1: M[1][1] x N[1][2]\nk = 2: M[1][2] x N[2][2]\n k = 3 M[1][3] x N[3][2] \n\nThen add all four -> P[1][2]",
      "autoResize": true,
      "lineHeight": 1.25
    },
