    {
      "id": "KPFq4WXoHlzAqeW3a6KvV",
      "type": "text",
      "x": 64.92446079864226,
      "y": 2239.499999571429,
      "width": 611.5796508789062,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 144707274,
      "version": 1641,
      "versionNonce": 1322425169,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791363391533,
      "link": null,
      "locked": false,
      "text": "Note: this is the image pattern again:\n2D grid over the output, one thread per cell.\nOnly step 3 is new: a loop instead of a \nsingle calculation.\n\nKey idea from this section:\nthe threads are laid out over P, the output, not over M or N.\nEach thread then reaches into M and N for whatever it needs.\n\nEach thread finds its cell in P, reaches into M and N for\nthe values it needs (one row of M and one column of N), \ncomputes the sum, and writes its one cell. \n\nThis is output-centric or \"gather\" mapping, where each\nthread owns one output and gathers its inputs.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: this is the image pattern again:\n2D grid over the output, one thread per cell.\nOnly step 3 is new: a loop instead of a \nsingle calculation.\n\nKey idea from this section:\nthe threads are laid out over P, the output, not over M or N.\nEach thread then reaches into M and N for whatever it needs.\n\nEach thread finds its cell in P, reaches into M and N for\nthe values it needs (one row of M and one column of N), \ncomputes the sum, and writes its one cell. \n\nThis is output-centric or \"gather\" mapping, where each\nthread owns one output and gathers its inputs.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
  "appState": {
    "gridSize": 20,
    "gridStep": 5,
    "gridModeEnabled": false,
