      "boundElements": [],
      "updated": 1791363391533,
      "link": null,
      "locked": false,
      "text": "Note: walking along a row = next-door slots.\nWalking down a column = jump Width slots each step.\nThat jump is what tiling dixes in Stage 6 (PMPP ch. 5-6).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: walking along a row = next-door slots.\nWalking down a column = jump Width slots each step.\nThat jump is what tiling dixes in Stage 6 (PMPP ch. 5-6).",
      "autoResize": true,
      "lineHeight": 1.25
    },
