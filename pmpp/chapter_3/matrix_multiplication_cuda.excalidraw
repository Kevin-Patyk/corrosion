      "updated": 1791363391532,
      "link": null,
      "locked": false,
      "text": "Note: row number -> which row of M.\ncol number -> which column of N.\nk walks along both at the same pace.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: row number -> which row of M.\ncol number -> which column of N.\nk walks along both at the same pace.",
