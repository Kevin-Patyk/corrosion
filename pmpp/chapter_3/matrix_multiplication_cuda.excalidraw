    {
      "id": "KPFq4WXoHlzAqeW3a6KvV",
      "type": "text",
      "x": 639.9244607986423,
      "y": 2529.499999571429,
      "width": 611.5796508789062,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
