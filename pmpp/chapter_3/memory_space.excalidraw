      "boundElements": [],
      "updated": 1791298121394,
      "link": null,
      "locked": false,
      "text": "Note: 1 box = 1 byte. Every box\nhas a number (its address). A u32\ntakes 4 boxes in a row: start 100,\nsize 4.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: 1 box = 1 byte. Every box\nhas a number (its address). A u32\ntakes 4 boxes in a row: start 100,\nsize 4.",
      "autoResize": true,
      "lineHeight": 1.25
    },
