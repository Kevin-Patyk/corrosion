      "width": 657.7783203125,
      "height": 458.2822265625001,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3B",
      "roundness": null,
      "seed": 282499861,
      "version": 437,
      "versionNonce": 1470926075,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790757587436,
      "link": null,
      "locked": false
    },
    {
      "id": "l2n8vT4WwggLpJwRrAbfA",
      "type": "text",
      "x": 330.70217879541013,
      "y": 1125.9891031875,
      "width": 57.29997253417969,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3C",
      "roundness": null,
      "seed": 1977380981,
      "version": 1203,
      "versionNonce": 1920434773,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790757476400,
      "link": null,
      "locked": false,
      "text": "Notes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oChqqYfrqk0eTd21dnkJ_",
      "type": "text",
      "x": 169.28614858593758,
      "y": 1161.128690912995,
      "width": 395.995361328125,
      "height": 90.75806964950536,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3D",
      "roundness": null,
      "seed": 1514183125,
      "version": 1548,
      "versionNonce": 425619381,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790757476400,
      "link": null,
      "locked": false,
      "text": "1. Memory is 1D. \nRAM and GPU memory are one long list of addresses.\nThere is no \"row 2, col 3\" in hardware, only address #N.\nEvery 2D/3D array must be flattened somehow.\n",
      "fontSize": 14.521291143920864,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Memory is 1D. \nRAM and GPU memory are one long list of addresses.\nThere is no \"row 2, col 3\" in hardware, only address #N.\nEvery 2D/3D array must be flattened somehow.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "R9hNWmwiI6If3aKOtwP4q",
      "type": "text",
      "x": 155.1890430234374,
      "y": 1246.3236399877476,
      "width": 395.995361328125,
      "height": 54.454841789703245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3E",
      "roundness": null,
      "seed": 1729664821,
      "version": 1855,
      "versionNonce": 331395349,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790757476400,
      "link": null,
      "locked": false,
      "text": "2. Allocating memory gives you one long strip.\nAsking for space for a W x H grid gives you\nW * H slots in a not a grid.",
      "fontSize": 14.521291143920864,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Allocating memory gives you one long strip.\nAsking for space for a W x H grid gives you\nW * H slots in a not a grid.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "np8SZBZW5lb6DCnIYI1xo",
      "type": "text",
      "x": 162.51871652343752,
      "y": 1317.8329106051483,
      "width": 395.995361328125,
      "height": 72.60645571960433,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3F",
      "roundness": null,
      "seed": 113895573,
      "version": 2156,
      "versionNonce": 2132002421,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790757476400,
      "link": null,
      "locked": false,
      "text": "3. A formula turns (row, col) into a slot number.\nSome languages hide this step, but it always happens.\nOn the GPU you usally write it yourself:\nslow = row * W + col",
      "fontSize": 14.521291143920864,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. A formula turns (row, col) into a slot number.\nSome languages hide this step, but it always happens.\nOn the GPU you usally write it yourself:\nslow = row * W + col",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "FlCpyDuEwGxFf7DbaHRFj",
      "type": "text",
      "x": 159.25546046093748,
      "y": 1409.379587452698,
      "width": 395.995361328125,
      "height": 36.30322785980216,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3G",
      "roundness": null,
      "seed": 990514677,
      "version": 2369,
      "versionNonce": 773664725,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790757476400,
      "link": null,
      "locked": false,
      "text": "4. Row-major vs column-major is just the choice of\nwhich direction gets flattened first.",
      "fontSize": 14.521291143920864,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Row-major vs column-major is just the choice of\nwhich direction gets flattened first.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5KE3_dWzzYWbGB0gRb0ud",
      "type": "text",
      "x": 192.22859351562505,
      "y": 1058.0116164306103,
      "width": 373.51904296875,
      "height": 16.655023138779125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3N",
      "roundness": null,
      "seed": 1465910101,
      "version": 2662,
      "versionNonce": 374098389,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790757469801,
      "link": null,
      "locked": false,
      "text": "Rule: neighboring threads should read neighboring memory.",
      "fontSize": 13.324018511023299,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rule: neighboring threads should read neighboring memory.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jbvQO4HobEn5KvYfFiSl6",
      "type": "text",
      "x": 156.56686933593755,
      "y": 1467.4868460700986,
      "width": 395.995361328125,
      "height": 36.30322785980216,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3P",
      "roundness": null,
      "seed": 303450075,
      "version": 2508,
      "versionNonce": 2129816885,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790757476400,
      "link": null,
      "locked": false,
      "text": "5. Neither is faster. Speed comes from reading\nin the same direction as data is stored.",
      "fontSize": 14.521291143920864,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Neither is faster. Speed comes from reading\nin the same direction as data is stored.",
      "autoResize": false,
      "lineHeight": 1.25
    },
