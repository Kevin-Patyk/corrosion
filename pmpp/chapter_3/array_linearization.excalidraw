    {
      "id": "_TXMAlOQWQfOvYEF2OJHB",
      "type": "text",
      "x": 241.32371545996102,
      "y": 1012.4712333056106,
      "width": 282.9697570800781,
      "height": 16.655023138779125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
