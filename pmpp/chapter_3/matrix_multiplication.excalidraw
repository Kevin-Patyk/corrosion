    {
      "id": "VSOXwKhX9ES899GR1Gj14",
      "type": "text",
      "x": 176.09610119053775,
      "y": 788.2460382222225,
      "width": 491.1397705078125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 1096692403,
      "version": 455,
      "versionNonce": 1412307984,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791363771255,
      "link": null,
      "locked": false,
      "text": "Note: the inner sizes (3 and 3) must match,\nsince a row of M and a column of N need the same\nlength to pair up. The outer sizes give P's shape.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: the inner sizes (3 and 3) must match,\nsince a row of M and a column of N need the same\nlength to pair up. The outer sizes give P's shape.",
      "autoResize": true,
      "lineHeight": 1.25
    },
