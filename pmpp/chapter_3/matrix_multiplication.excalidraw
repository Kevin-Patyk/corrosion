      "text": "P[row][col] = row \"row\" of M * column \"col\" of N",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P[row][col] = row \"row\" of M * column \"col\" of N",
      "autoResize": true,
