    {
      "id": "WYREVe9BQJwI1xfUOP9Jm",
      "type": "text",
      "x": 500.9856569605033,
      "y": -8.999999555555462,
      "width": 547.0286865234375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1456466813,
      "version": 490,
      "versionNonce": 693828624,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791363989710,
      "link": null,
      "locked": false,
      "text": "P[0][0] = row 0 dot col 0 = 1*7 + 2*9 + 3*11 = 58\nP[0][1] = row 0 dot col 1 = 1*8 + 2 * 10 + 3*12 = 64\nP[1][0] = row 1 dot col 0 = 4*7 + 5*9 + 6*11 = 139\nP[1][1] = row 1 dot col 1 = 4*8 + 5*10 + 6*12 = 154",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P[0][0] = row 0 dot col 0 = 1*7 + 2*9 + 3*11 = 58\nP[0][1] = row 0 dot col 1 = 1*8 + 2 * 10 + 3*12 = 64\nP[1][0] = row 1 dot col 0 = 4*7 + 5*9 + 6*11 = 139\nP[1][1] = row 1 dot col 1 = 4*8 + 5*10 + 6*12 = 154",
      "autoResize": true,
      "lineHeight": 1.25
    },
