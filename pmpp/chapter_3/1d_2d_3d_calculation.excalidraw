      "link": null,
      "locked": false,
      "text": "Data: n elements\nBlock: 256\nGrid: Ceil(n / 256)\nEdges: 1 -> the end (i < n)\n\nExample: 1000 elements\n1000 / 256 = 3.9 -> 4 blocks",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data: n elements\nBlock: 256\nGrid: Ceil(n / 256)\nEdges: 1 -> the end (i < n)\n\nExample: 1000 elements\n1000 / 256 = 3.9 -> 4 blocks",
      "autoResize": true,
      "lineHeight": 1.25
    },
