    {
      "id": "LsrXogo797KlmZhbqSCKx",
      "type": "text",
      "x": 313.550048770996,
      "y": -555,
      "width": 380.25982666015625,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1458783137,
      "version": 1175,
      "versionNonce": 759060822,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791297963629,
      "link": null,
      "locked": false,
      "text": "Data: width x height x depth\nBlock: 8 x 8 x 4\nGrid: ceil (width / 8) across\n       ceil(height / 8) down\n       ceil(depth / 4) deep\nEdges: 3 -> right (col < width)\n               bottom (row < height)\n               back (later < depth)\n\nExample: 20 x 10 x 6, 8 x 8 x 4 blocks\n20 / 8 = 2.5 -> 3 across\n10 / 8 = 1.25 -> 2 down\n6 / 4 = 1.5 -> 2 deep\ngrid = 3 x 2 x 2 = 12 blocks",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data: width x height x depth\nBlock: 8 x 8 x 4\nGrid: ceil (width / 8) across\n       ceil(height / 8) down\n       ceil(depth / 4) deep\nEdges: 3 -> right (col < width)\n               bottom (row < height)\n               back (later < depth)\n\nExample: 20 x 10 x 6, 8 x 8 x 4 blocks\n20 / 8 = 2.5 -> 3 across\n10 / 8 = 1.25 -> 2 down\n6 / 4 = 1.5 -> 2 deep\ngrid = 3 x 2 x 2 = 12 blocks",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eEvkKBq-FAVpONAK0BVUX",
