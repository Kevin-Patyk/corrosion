    {
      "id": "0yUb7BEAAzHNLGoK4ysfA",
      "type": "text",
      "x": -95.44995122900389,
      "y": -555,
      "width": 336.89990234375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 748695759,
      "version": 744,
      "versionNonce": 697383318,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791297963629,
      "link": null,
      "locked": false,
      "text": "Data: width x height\nBlock: 16 x 16\nGrid: ceil(width / 16) across\n       ceil(height / 16) down\nEdges: 2 -> right (col < width)\n               bottom (row < height)\n\nExample: 10 x 6 image, 4x4 blocks\n10 / 4 = 2.5 -> 3 across\n6 / 4 = 1.5 -> 2 down\ngrid = 3 x 2 = 6 blocks\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data: width x height\nBlock: 16 x 16\nGrid: ceil(width / 16) across\n       ceil(height / 16) down\nEdges: 2 -> right (col < width)\n               bottom (row < height)\n\nExample: 10 x 6 image, 4x4 blocks\n10 / 4 = 2.5 -> 3 across\n6 / 4 = 1.5 -> 2 down\ngrid = 3 x 2 = 6 blocks\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
