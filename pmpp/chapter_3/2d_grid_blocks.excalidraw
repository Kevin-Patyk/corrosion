      "link": null,
      "locked": false,
      "index": "b0Y"
    },
    {
      "id": "-wAjG463VnQeiA5Tz6zTr",
      "type": "text",
      "x": 345.1280822753906,
      "y": -212.0000004985664,
      "width": 708.7438354492188,
      "height": 63.910388498566476,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 626523729,
      "version": 417,
      "versionNonce": 1348553159,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791298106611,
      "link": null,
      "locked": false,
      "text": "The total size of a block in current CUDA systems is limited to 1024 threads.\nThese threads can be distributed across the 3 dimensions as long as the total # of\nthreads does not exceed 1024.",
      "fontSize": 17.042770266284393,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The total size of a block in current CUDA systems is limited to 1024 threads.\nThese threads can be distributed across the 3 dimensions as long as the total # of\nthreads does not exceed 1024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kjHi0CuPEdPsivjIkAar3",
      "type": "text",
      "x": 372.75836181640625,
      "y": -117.60692524928328,
      "width": 653.4832763671875,
      "height": 42.60692566571098,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 1507611007,
      "version": 618,
      "versionNonce": 490895591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791298106611,
      "link": null,
      "locked": false,
      "text": "A grid and its blocks do not need to have the same dimensionality. A grid can \nhave higher dimensionality than its blocks and vice versa.",
      "fontSize": 17.042770266284393,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A grid and its blocks do not need to have the same dimensionality. A grid can \nhave higher dimensionality than its blocks and vice versa.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XQXRA1FuCpWMXpIUr8gl3",
      "type": "text",
      "x": 322.021240234375,
      "y": -25.00000005965734,
      "width": 754.95751953125,
      "height": 61.31160472536827,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 1823340625,
      "version": 1001,
      "versionNonce": 275825671,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791298106611,
      "link": null,
      "locked": false,
      "text": "The choice of 1D, 2D, or 3D thread organizations is usually based on the nature of the data.\nFor example, pictures are 2D arrays of pixels. Using a 2D grid that consists of 2D blocks\nis often convenient for processing the pixels in a picture.",
      "fontSize": 16.34976126009821,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The choice of 1D, 2D, or 3D thread organizations is usually based on the nature of the data.\nFor example, pictures are 2D arrays of pixels. Using a 2D grid that consists of 2D blocks\nis often convenient for processing the pixels in a picture.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
  "appState": {
    "gridSize": 20,
    "gridStep": 5,
    "gridModeEnabled": false,
    "viewBackgroundColor": "#ffffff"
  },
