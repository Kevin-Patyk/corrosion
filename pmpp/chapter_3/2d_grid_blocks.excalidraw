    {
      "id": "BrRAdWdbpZOpX0YYtsBvZ",
      "type": "text",
      "x": -394.869812,
      "y": 172.5,
      "width": 638.7396240234375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1920828234,
      "version": 109,
      "versionNonce": 2076458887,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791298106611,
      "link": null,
      "locked": false,
      "text": "Image: 6 wide x 5 tall = 30 pixels\nBlock: 4 x 4 threads.  Grid: 2 x 2 blocks = 64 threads\nBlue = thread with a pixel (30)\nGrey, dashed = idle thread, off the edge (34)\nRed line = edge of the image\nBlock labels are (x, y)\nOrange example: block (1,1), thread (1,0)\n   col = 1*4 + 1 = 5,  row = 1*4 + 0 = 4  ->  bottom-right pixel",
      "originalText": "Image: 6 wide x 5 tall = 30 pixels\nBlock: 4 x 4 threads.  Grid: 2 x 2 blocks = 64 threads\nBlue = thread with a pixel (30)\nGrey, dashed = idle thread, off the edge (34)\nRed line = edge of the image\nBlock labels are (x, y)\nOrange example: block (1,1), thread (1,0)\n   col = 1*4 + 1 = 5,  row = 1*4 + 0 = 4  ->  bottom-right pixel",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0X"
    },
    {
      "id": "9svWhc_vtdkMF_UJcI1vr",
      "type": "rectangle",
      "x": 312,
      "y": -223.25,
      "width": 775,
      "height": 283.00000000000006,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1224973663,
      "version": 158,
      "versionNonce": 1413527207,
      "isDeleted": false,
      "boundElements": [],
