      "isDeleted": false,
      "boundElements": null,
      "updated": 1793285496464,
      "link": null,
      "locked": false,
      "text": "A process block runs 1 warp at a time, but holds many. A warp\nwaiting on a slow load is \"not ready\": the dispatcher skips it and picks a ready one\n(fine-grained multithreading). The switch is free: all warps' state\nalready lives on the SM (zero-overhead scheduling). Enough\nresident warps = always someone ready = cores never idle,\nso the waits are \"hidden\".",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A process block runs 1 warp at a time, but holds many. A warp\nwaiting on a slow load is \"not ready\": the dispatcher skips it and picks a ready one\n(fine-grained multithreading). The switch is free: all warps' state\nalready lives on the SM (zero-overhead scheduling). Enough\nresident warps = always someone ready = cores never idle,\nso the waits are \"hidden\".",
      "autoResize": true,
      "lineHeight": 1.25
    }
