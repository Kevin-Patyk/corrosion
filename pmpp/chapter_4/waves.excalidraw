      "seed": 361872461,
      "version": 146,
      "versionNonce": 277671683,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792848766067,
      "link": null,
      "locked": false,
      "text": "In this example, the GPU has 4  SMs\nand each SM can hold one block at a time.",
