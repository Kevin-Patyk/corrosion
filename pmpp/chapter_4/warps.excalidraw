      "link": null,
      "locked": false,
      "text": "3. Warps per block = 256/32 = 8. Warps in the SM = 8x3 = 24",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Warps per block = 256/32 = 8. Warps in the SM = 8x3 = 24",
      "autoResize": true,
      "lineHeight": 1.25
    },
