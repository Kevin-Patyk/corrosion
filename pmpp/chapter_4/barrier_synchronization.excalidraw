    },
    {
      "id": "F9mAmCIO106x5UM8Vp2v9",
      "type": "text",
      "x": 1090.180174953125,
      "y": 207.653274,
      "width": 326.23974609375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1483658612,
      "version": 431,
      "versionNonce": 145306868,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792681673919,
      "link": null,
      "locked": false,
      "text": "Green = running; the thread\nexecutes its own instructions.\n\nRed = waiting; held at the\nbarrier until everyone in the block\nhas arrived.\n\nVertical line: release. All threads\ncontinue past the barrier\ntogether.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Green = running; the thread\nexecutes its own instructions.\n\nRed = waiting; held at the\nbarrier until everyone in the block\nhas arrived.\n\nVertical line: release. All threads\ncontinue past the barrier\ntogether.",
      "autoResize": true,
      "lineHeight": 1.25
    },
