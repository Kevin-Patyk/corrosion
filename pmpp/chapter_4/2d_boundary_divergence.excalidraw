    {
      "id": "2nhucLHuNd5NMQM7GzVAI",
      "type": "text",
      "x": 471.28038035776297,
      "y": 1543.72784615873,
      "width": 781.819580078125,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
