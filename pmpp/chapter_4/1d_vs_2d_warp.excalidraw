    },
    {
      "id": "4mlPyEGDwqKLW9jszMg5P",
      "type": "text",
      "x": 1165.976957079644,
      "y": 190.25000022222218,
      "width": 651.5195922851562,
      "height": 900,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0w",
      "roundness": null,
      "seed": 407037483,
      "version": 1909,
      "versionNonce": 1211572343,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793180391588,
      "link": null,
      "locked": false,
      "text": "1D block: warps are consecutive runs of 32 along threadIdx.x. \nNothing to flatten.\n\n2D/3D block: first flatten to a line, row-major (x-fastest, then\ny, then z), then cut into 32s.\n\nFor 2D, it is the same as your linearizing formula\nfor memory: flat = y * width + x. Here width =\nblock width.\n\nNot a multiple of 32: the last warp is padded with inactive\nthreads that occupy slots but do nothing.\n\nPadding wastes slots: 48 threads use 2 warps' worth of\nhardware for 1.5 warps of work.\n\nRule of thumb: block sizes are multiples of 32 \n(your 256 = 8 full warps, no padding).\n\nTwo different linearizings, same formula shape. The hardware\nlinearizies threads (flat = y * block width + x) to cut a \n2D block into warps. \nOur kernel linearizes memory (spot = row * picture width + col) \nto find a pixel. Different width, different thing being numbered.\n\nFirst, the threads in a block are linearized, so the\nhardware can cut them into warps. Second, a \n(row, col) is linearized by the code to find a spot in memory.\n\nIt's the same formula using different numbers since\nthe block dimensions are different than our output dimensions. For\nexample, a block is 16 wide and the picture is 1280 wide,\nso the \"x width\" in each formula uses a different number. \nSame arithmetic applied to two different grids: one the grid of \nthreads in a block, the other the grid of pixels\nin the picture.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1D block: warps are consecutive runs of 32 along threadIdx.x. \nNothing to flatten.\n\n2D/3D block: first flatten to a line, row-major (x-fastest, then\ny, then z), then cut into 32s.\n\nFor 2D, it is the same as your linearizing formula\nfor memory: flat = y * width + x. Here width =\nblock width.\n\nNot a multiple of 32: the last warp is padded with inactive\nthreads that occupy slots but do nothing.\n\nPadding wastes slots: 48 threads use 2 warps' worth of\nhardware for 1.5 warps of work.\n\nRule of thumb: block sizes are multiples of 32 \n(your 256 = 8 full warps, no padding).\n\nTwo different linearizings, same formula shape. The hardware\nlinearizies threads (flat = y * block width + x) to cut a \n2D block into warps. \nOur kernel linearizes memory (spot = row * picture width + col) \nto find a pixel. Different width, different thing being numbered.\n\nFirst, the threads in a block are linearized, so the\nhardware can cut them into warps. Second, a \n(row, col) is linearized by the code to find a spot in memory.\n\nIt's the same formula using different numbers since\nthe block dimensions are different than our output dimensions. For\nexample, a block is 16 wide and the picture is 1280 wide,\nso the \"x width\" in each formula uses a different number. \nSame arithmetic applied to two different grids: one the grid of \nthreads in a block, the other the grid of pixels\nin the picture.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
  "appState": {
    "gridSize": 20,
    "gridStep": 5,
    "gridModeEnabled": false,
    "viewBackgroundColor": "#ffffff"
  },
