    {
      "id": "UeDWtOdK2gZSYJjFm9o7P",
      "type": "text",
      "x": 593.0000001035156,
      "y": 714,
      "width": 71.29998779296875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
