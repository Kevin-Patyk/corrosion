      "locked": false
    },
    {
      "id": "J38hn-D642PkYofguDLAQ",
      "type": "text",
      "x": 1190.4849713105468,
      "y": 1061.169725,
      "width": 53.39996337890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
