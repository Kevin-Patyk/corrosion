      "isDeleted": false,
      "boundElements": null,
      "updated": 1793288747139,
      "link": null,
      "locked": false,
      "text": "One SM, four pools. Fill each pool on its own, then take the smallest answer.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One SM, four pools. Fill each pool on its own, then take the smallest answer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
