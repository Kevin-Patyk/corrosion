    {
      "id": "2frjfnDlWxlWjFWrcWgS6",
      "type": "text",
      "x": 375.24594920647326,
      "y": 339.6428594285714,
      "width": 661.779541015625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
