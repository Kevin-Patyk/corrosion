      "text": "toy SM: 64 thread seats, 8 block seats, 1024 registers, 4 KB shared memory\ntoy block: 16 threads, 20 registers per thread (16x20 = 320), 1 KB shared memory",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "toy SM: 64 thread seats, 8 block seats, 1024 registers, 4 KB shared memory\ntoy block: 16 threads, 20 registers per thread (16x20 = 320), 1 KB shared memory",
      "autoResize": true,
      "lineHeight": 1.25
    },
