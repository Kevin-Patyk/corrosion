    },
    {
      "id": "61Ub9h8Z_mdh906RaSIij",
      "type": "text",
      "x": 477.4600601035156,
      "y": 507.591357,
      "width": 71.29998779296875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
