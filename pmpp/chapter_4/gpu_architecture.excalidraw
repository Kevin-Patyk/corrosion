    {
      "id": "9it1B3y9sTO7y7B7_cK4p",
      "type": "text",
      "x": 668.7899931035156,
      "y": 784.75,
      "width": 71.29998779296875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
