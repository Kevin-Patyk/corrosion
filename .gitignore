# --- Cargo ---
target/
debug/
**/*.rs.bk          # rustfmt backups
*.pdb               # MSVC debug info
**/mutants.out*/    # cargo-mutants

# --- GPU build artifacts ---
*.spv               # compiled SPIR-V (rust-gpu, naga)
*.ptx               # compiled PTX (cudarc, nvcc)
*.cubin
*.fatbin
*.sass
*.o

# --- Profilers ---
*.ncu-rep           # Nsight Compute
*.nsys-rep          # Nsight Systems
*.qdrep
*.sqlite            # Nsight Systems databases
*.rdc               # RenderDoc captures
*.nvvp

# --- Data and outputs ---
data/               # MNIST etc. — add a download script instead
out/
*.png               # rendered images from stages 1, 2, 5
*.ppm
*.exr
!assets/**          # but keep inputs you check in on purpose

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Env ---
.env